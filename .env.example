# Copy values into Vercel → Project → Settings → Environment Variables.
# Never commit real secrets.

# Required on Vercel (openssl rand -hex 32)
HEARTHBOUND_JWT_SECRET=replace-with-openssl-rand-hex-32

# Required on Vercel — Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
