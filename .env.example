# Copy values into Vercel → Project → Settings → Environment Variables.
# Never commit real secrets.

# Required on Vercel (openssl rand -hex 32)
HEARTHBOUND_JWT_SECRET=replace-with-openssl-rand-hex-32

# Required on Vercel — Supabase Postgres URI
# Supabase → Project Settings → Database → Connection string → URI
# Prefer the Transaction pooler (port 6543) for Vercel serverless.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
